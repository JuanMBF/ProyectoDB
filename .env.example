# Copiá este archivo a .env para correr la app fuera de Docker.

# Sin esta variable se usa SQLite en ./data/precios.db.
# Con `docker compose up -d` levantado, MySQL queda en el puerto 3306:
# DATABASE_URL=mysql+pymysql://precios:precios@127.0.0.1:3306/precios?charset=utf8mb4

# Zona raw. Vacío = no se archivan las respuestas crudas.
# Los nodos del replica set se anuncian como mongo1/mongo2/mongo3 (nombres internos de Docker), así que
# desde fuera de Docker conviene conectarse directo a mongo1 (el primario preferido). Para usar el replica
# set completo, correr la app con `docker compose run --rm app ...`.
# MONGO_URL=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DATABASE=preciosdb

# Pausa entre requests a los sitios (segundos).
REQUEST_DELAY_SECONDS=1.0
